# Copia este archivo a .env, completa los valores y cárgalo antes de arrancar:
#   set -a; source .env; set +a

# --- Acceso al panel (obligatorio). Formato usuario:clave separados por coma ---
PANEL_USERS=laura:cambia-esta-clave,asistente:cambia-esta-otra

# --- Quién recibe los avisos por WhatsApp (Dra Laura y su asistente) ---
STAFF_PHONES=+54 9 11 0000 0001,+54 9 11 0000 0002

# --- General ---
DB_PATH=consultorio.db
TIMEZONE=America/Argentina/Buenos_Aires
DEFAULT_COUNTRY_CODE=54
APPOINTMENT_MINUTES=30
SEND_WINDOW_START=8
SEND_WINDOW_END=21

# --- WhatsApp Cloud API (Meta). Sin token/ID, los mensajes se simulan en el log ---
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=un-texto-secreto-que-eliges-tu
WA_APP_SECRET=
WA_LANGUAGE=es
WA_TEMPLATE_FIRST=recordatorio_cita_7d
WA_TEMPLATE_LAST=recordatorio_cita_1d
WA_TEMPLATE_STAFF=aviso_consultorio

# --- Google Calendar (cuenta de servicio). Sin esto, no se crean eventos ---
GOOGLE_CALENDAR_ID=
GOOGLE_CREDENTIALS_FILE=service-account.json
